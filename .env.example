# Copy to .env, which docker compose reads and git ignores, and change what you need.
# Every value here is for a local stack on 127.0.0.1 only.

# The local tag the service, the Slack stub and the fake SES are built under.
# OUTBOX_COMMS_IMAGE=outbox-comms:local

# Attachments live in one folder per organization, <organization_id>/<key>, under
# the service's OUTBOX_COMMS_ATTACHMENTS_DIR (/data/attachments in the container).

# Host ports, each bound to 127.0.0.1.
# OUTBOX_COMMS_GRPC_PORT=9090
# OUTBOX_COMMS_HTTP_PORT=8080
# OUTBOX_COMMS_STUB_PORT=8090
# OUTBOX_COMMS_MAILPIT_PORT=8025

# For `go run ./cmd/outbox-comms serve` on the host against the stack's Postgres
# and Redis, which compose does not publish: publish them in an override first.
# The password is local-only, the one compose.yaml gives Postgres. Never reuse it.
# OUTBOX_COMMS_DATABASE_URL=postgres://outbox:outbox-local-only@localhost:5432/outbox_comms?sslmode=disable
# OUTBOX_COMMS_REDIS_ADDR=localhost:6379
# OUTBOX_COMMS_SLACK_BOT_TOKEN=local-only-token
