{
  "uid": "outbox-comms",
  "title": "outbox-comms delivery",
  "tags": [
    "outbox-comms",
    "delivery"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "refresh": "5m",
  "schemaVersion": 42,
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 0,
      "panels": []
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(outbox_comms_message_transitions_total{job=~\"$job\",to_status=\"MESSAGE_STATUS_SENT\"}[24h])) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Sent (24h)",
      "description": "Email messages the provider accepted (SENT) over 24h. Slack messages go straight to DELIVERED.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(outbox_comms_message_transitions_total{job=~\"$job\",to_status=\"MESSAGE_STATUS_DELIVERED\"}[24h])) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Delivered (24h)",
      "description": "Messages that reached DELIVERED over 24h: a Slack ack, or an email delivery event.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "sum(increase(outbox_comms_dead_total{job=~\"$job\"}[24h])) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Dead (24h)",
      "description": "Messages terminated DEAD over 24h, all reason classes. Re-drive with `outbox-comms admin redrive-dead` once the cause is fixed. Alert: OutboxCommsDeadIncidentSpike fires on a permanent_config/render_bug burst.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 20,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_comms_bounce_rate{job=~\"$job\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Bounce Rate",
      "description": "Rolling hard-bounce rate (reputation guard). SES can pause a sender near 10%. Alert: OutboxCommsBounceRateHigh fires at 5%, leaving room to react.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.03,
                "color": "yellow"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_comms_complaint_rate{job=~\"$job\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Complaint Rate",
      "description": "Rolling complaint rate (reputation guard). SES can pause a sender near 0.5%. Alert: OutboxCommsComplaintRateHigh fires at 0.1%.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.0005,
                "color": "yellow"
              },
              {
                "value": 0.001,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "targets": [
        {
          "expr": "outbox_comms_overdue_pending{job=~\"$job\"}",
          "instant": true,
          "range": false,
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "title": "Overdue Pending",
      "description": "FAILED rows whose next_retry_at is past but still pending: the retry-path health signal. A sustained non-zero value means retry tasks are not draining. Alert: OutboxCommsRetriesNotDraining.",
      "transparent": false,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "repeatDirection": "h",
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "justifyMode": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "reduceOptions": {
          "calcs": []
        },
        "percentChangeColorMode": "standard",
        "orientation": ""
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 50,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": true,
      "title": "Throughput",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 0,
      "panels": [
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum by (to_status) (rate(outbox_comms_message_transitions_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "{{to_status}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Transitions by Target Status",
          "description": "Per-interval message status transitions split by to_status. A growing FAILED or DEAD share is the first sign of trouble.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 6
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum by (channel) (rate(outbox_comms_message_transitions_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "{{channel}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Transitions by Channel",
          "description": "Per-interval transitions split by channel (CHANNEL_EMAIL / CHANNEL_SLACK). Shows the email/Slack send mix and a per-channel stall.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 6
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "type": "row",
      "collapsed": true,
      "title": "Latency",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 0,
      "panels": [
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "histogram_quantile(0.5, sum(rate(outbox_comms_delivery_latency_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p50",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            },
            {
              "expr": "histogram_quantile(0.95, sum(rate(outbox_comms_delivery_latency_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p95",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            },
            {
              "expr": "histogram_quantile(0.99, sum(rate(outbox_comms_delivery_latency_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p99",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Delivery Latency by Channel (p50/p95/p99)",
          "description": "Fan-out to SENT/DELIVERED latency by channel. The p99 tail is where a delivery-latency breach shows first.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 0,
            "y": 15
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "histogram_quantile(0.5, sum(rate(outbox_comms_dispatch_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p50",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            },
            {
              "expr": "histogram_quantile(0.95, sum(rate(outbox_comms_dispatch_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p95",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            },
            {
              "expr": "histogram_quantile(0.99, sum(rate(outbox_comms_dispatch_duration_seconds_bucket{job=~\"$job\"}[$__rate_interval])) by (le, channel))",
              "legendFormat": "p99",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Dispatch Duration by Channel (p50/p95/p99)",
          "description": "Per-provider-call dispatch duration by channel (the email or Slack call itself). A rising tail here points at the provider, not the pipeline.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 12,
            "x": 12,
            "y": 15
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "type": "row",
      "collapsed": true,
      "title": "Failures",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "id": 0,
      "panels": [
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum by (reason_class) (rate(outbox_comms_dead_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "{{reason_class}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "DEAD by Reason Class",
          "description": "DEAD terminations split by reason_class. transient_exhausted usually means a bad address or channel, and crash_exhausted a worker that stopped mid-send on every attempt; permanent_config and render_bug are sending-side incidents and drive OutboxCommsDeadIncidentSpike.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 0,
            "y": 24
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum by (reason) (rate(outbox_comms_unconfirmed_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "{{reason}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "UNCONFIRMED by Reason",
          "description": "Messages terminated UNCONFIRMED, by reason: uncertain_send (a BEST_EFFORT send with no ack) or no_delivery_feedback (a CONFIRMED email with no delivery event in the window). A rise in no_delivery_feedback means email feedback stopped arriving.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 6,
            "y": 24
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum(rate(outbox_comms_orphan_feedback_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "orphans",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Orphan Email Feedback",
          "description": "Email feedback events with no matching dispatched message. A sustained non-zero rate means the provider_message_id correlation is broken. Alert: OutboxCommsOrphanFeedback.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 12,
            "y": 24
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        },
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "sum by (reason) (rate(outbox_comms_feedback_dropped_total{job=~\"$job\"}[$__rate_interval]))",
              "legendFormat": "{{reason}}",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              }
            }
          ],
          "title": "Dropped Email Feedback by Reason",
          "description": "Email feedback the service could not read and dropped at once, by reason: malformed_json (the body is not JSON) or missing_message_id (no mail.messageId). Nonzero means the feedback queue carries something other than SES notifications.",
          "transparent": false,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "h": 8,
            "w": 6,
            "x": 18,
            "y": 24
          },
          "repeatDirection": "h",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "showLegend": true,
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "custom": {
                "drawStyle": "line",
                "gradientMode": "opacity",
                "lineWidth": 1,
                "lineInterpolation": "smooth",
                "fillOpacity": 15,
                "showPoints": "never",
                "spanNulls": false
              }
            },
            "overrides": []
          }
        }
      ]
    },
    {
      "type": "row",
      "collapsed": true,
      "title": "Sender Reputation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 0,
      "panels": [
        {
          "type": "timeseries",
          "targets": [
            {
              "expr": "max(outbox_comms_bounce_rate{job=~\"$job\"})",
              "legendFormat": "bounce rate",
